{
  "name": "honox-kakeibo",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode client && vite build",
    "preview": "wrangler pages dev",
    "format": "npx prettier --write .",
    "deploy": "yarn build&&wrangler deploy",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "knip": "knip"
  },
  "private": true,
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.10.3",
    "@hono/firebase-auth": "^1.4.2",
    "@hono/zod-validator": "^0.9.1",
    "@modelcontextprotocol/server": "^2.0.0",
    "@tailwindcss/forms": "^0.5.11",
    "chart.js": "^4.5.1",
    "firebase": "^12.16.0",
    "hono": "^4.13.8",
    "honox": "^0.1.61",
    "typescript": "^6.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^4.20260701.1",
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitest/coverage-istanbul": "^4.1.11",
    "@vitest/ui": "^4.1.9",
    "jsdom": "^30.0.1",
    "knip": "^5.84.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.9",
    "wrangler": "^4.143.0"
  }
}
