// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`generateInsertQuery > asset 1`] = `"INSERT INTO asset (date, amount, asset_category_id, description) VALUES (?, ?, ?, ?)"`;

exports[`generateInsertQuery > asset_category 1`] = `"INSERT INTO asset_category (name, is_investment) VALUES (?, ?)"`;

exports[`generateInsertQuery > expense 1`] = `"INSERT INTO expense (date, amount, expense_category_id, payment_method_id, description) VALUES (?, ?, ?, ?, ?)"`;

exports[`generateInsertQuery > expense_category 1`] = `"INSERT INTO expense_category (name) VALUES (?)"`;

exports[`generateInsertQuery > expense_check_template 1`] = `"INSERT INTO expense_check_template (name, expense_category_id, description_pattern, is_active, payment_method_id) VALUES (?, ?, ?, ?, ?)"`;

exports[`generateInsertQuery > fund_transaction 1`] = `"INSERT INTO fund_transaction (date, amount, description) VALUES (?, ?, ?)"`;

exports[`generateInsertQuery > income 1`] = `"INSERT INTO income (date, amount, income_category_id, description) VALUES (?, ?, ?, ?)"`;

exports[`generateInsertQuery > income_category 1`] = `"INSERT INTO income_category (name) VALUES (?)"`;

exports[`generateInsertQuery > payment_method 1`] = `"INSERT INTO payment_method (name) VALUES (?)"`;

exports[`generateSelectQuery > asset 1`] = `"SELECT asset.id, asset.date, asset.amount, asset.asset_category_id, asset.description, asset.created_at, asset.updated_at, asset_category.name AS category_name, asset_category.is_investment AS is_investment FROM asset JOIN asset_category ON asset.asset_category_id = asset_category.id"`;

exports[`generateSelectQuery > asset_category 1`] = `"SELECT asset_category.id, asset_category.name, asset_category.is_investment, asset_category.created_at, asset_category.updated_at FROM asset_category"`;

exports[`generateSelectQuery > expense 1`] = `"SELECT expense.id, expense.date, expense.amount, expense.expense_category_id, expense.payment_method_id, expense.description, expense.created_at, expense.updated_at, expense_category.name AS category_name, payment_method.name AS payment_method_name FROM expense JOIN expense_category ON expense.expense_category_id = expense_category.id JOIN payment_method ON expense.payment_method_id = payment_method.id"`;

exports[`generateSelectQuery > expense_category 1`] = `"SELECT expense_category.id, expense_category.name, expense_category.created_at, expense_category.updated_at FROM expense_category"`;

exports[`generateSelectQuery > expense_check_template 1`] = `"SELECT expense_check_template.id, expense_check_template.name, expense_check_template.expense_category_id, expense_check_template.payment_method_id, expense_check_template.description_pattern, expense_check_template.is_active, expense_check_template.created_at, expense_check_template.updated_at, expense_category.name AS category_name, payment_method.name AS payment_method_name FROM expense_check_template JOIN expense_category ON expense_check_template.expense_category_id = expense_category.id LEFT JOIN payment_method ON expense_check_template.payment_method_id = payment_method.id"`;

exports[`generateSelectQuery > fund_transaction 1`] = `"SELECT fund_transaction.id, fund_transaction.date, fund_transaction.amount, fund_transaction.description, fund_transaction.created_at, fund_transaction.updated_at FROM fund_transaction"`;

exports[`generateSelectQuery > income 1`] = `"SELECT income.id, income.date, income.amount, income.income_category_id, income.description, income.created_at, income.updated_at, income_category.name AS category_name FROM income JOIN income_category ON income.income_category_id = income_category.id"`;

exports[`generateSelectQuery > income_category 1`] = `"SELECT income_category.id, income_category.name, income_category.created_at, income_category.updated_at FROM income_category"`;

exports[`generateSelectQuery > payment_method 1`] = `"SELECT payment_method.id, payment_method.name, payment_method.created_at, payment_method.updated_at FROM payment_method"`;

exports[`generateUpdateQuery > asset 1`] = `"UPDATE asset SET date = ?, amount = ?, asset_category_id = ?, description = ?, updated_at = ? WHERE id = ?;"`;

exports[`generateUpdateQuery > asset_category 1`] = `"UPDATE asset_category SET name = ?, is_investment = ?, updated_at = ? WHERE id = ?;"`;

exports[`generateUpdateQuery > expense 1`] = `"UPDATE expense SET date = ?, amount = ?, expense_category_id = ?, payment_method_id = ?, description = ?, updated_at = ? WHERE id = ?;"`;

exports[`generateUpdateQuery > expense_category 1`] = `"UPDATE expense_category SET name = ?, updated_at = ? WHERE id = ?;"`;

exports[`generateUpdateQuery > expense_check_template 1`] = `"UPDATE expense_check_template SET name = ?, expense_category_id = ?, description_pattern = ?, is_active = ?, payment_method_id = ?, updated_at = ? WHERE id = ?;"`;

exports[`generateUpdateQuery > fund_transaction 1`] = `"UPDATE fund_transaction SET date = ?, amount = ?, description = ?, updated_at = ? WHERE id = ?;"`;

exports[`generateUpdateQuery > income 1`] = `"UPDATE income SET date = ?, amount = ?, income_category_id = ?, description = ?, updated_at = ? WHERE id = ?;"`;

exports[`generateUpdateQuery > income_category 1`] = `"UPDATE income_category SET name = ?, updated_at = ? WHERE id = ?;"`;

